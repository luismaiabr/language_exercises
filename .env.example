# Supabase Credentials (from your Supabase project settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# OpenRouter API Key (Gemini Flash model via OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# n8n Webhook Ingestion API Key (passed in X-API-Key header)
N8N_API_KEY=your-internal-n8n-secret-api-key

# CORS Allowed Origins
CORS_ORIGINS=["https://l.xseed.space", "https://l.xeed.space", "https://lcore.xseed.space", "https://lfront.xseed.space", "https://lschedule.xseed.space", "http://localhost:5173", "http://localhost:3000", "http://localhost:8000", "http://localhost:8001"]

# Optional overrides (defaults are loaded from config/*.yaml)
# SERVER_PORT=8000
# MAGIC_LINK_TIMESPAN_DAYS=7
MAGIC_LINK_BASE_URL=https://lfront.xseed.space/lesson
FRONTEND_BASE_URL=https://lfront.xseed.space

# Instant Dispatch (true: sends email immediately on creation & bypasses scheduler daemon)
INSTANT_DISPATCH=true

# Scheduler Service Trigger URL (fallback for instant dispatch trigger)
SCHEDULER_URL=https://lschedule.xseed.space
# CRON_SECRET=your-cron-secret

# SMTP Configuration (for direct email delivery from backend)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=education@xseed.space
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=education@xseed.space
SMTP_FROM_NAME=Deutsch Daily
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=15
